msgid "SSH client"
msgstr "SSH 客户端"

msgid "SSH connections"
msgstr "SSH 连接"

msgid "Harbor Core keeps one russh connection per device and reuses it. Idle timeout and channel limits apply to that pool."
msgstr "Harbor Core 为每台设备保持一条 russh 连接并复用。空闲超时与通道上限作用于该连接池。"

msgid "Idle timeout (seconds)"
msgstr "空闲断开时间（秒）"

msgid "Maximum pooled connections"
msgstr "最大并发通道数"

msgid "Enter valid SSH connection limits"
msgstr "请输入有效的 SSH 连接限制"

# Path access settings and Core API messages
msgid "Path access"
msgstr "路径访问"

msgid "Filesystem access policy"
msgstr "文件系统访问策略"

msgid "Access mode"
msgstr "访问模式"

msgid "Choose unrestricted access, an allowlist, or a blacklist. The selected policy is enforced for local and remote file operations."
msgstr "选择不限制访问、白名单或黑名单模式。所选策略会同时应用于本机和远程文件操作。"

msgid "Unrestricted"
msgstr "不限制"

msgid "Allowlist"
msgstr "白名单"

msgid "Blacklist"
msgstr "黑名单"

msgid "Allowed roots"
msgstr "允许的根目录"

msgid "One absolute directory per line. Only these directories and their descendants are accessible."
msgstr "每行填写一个绝对目录路径。仅可访问这些目录及其子目录。"

msgid "Blocked roots"
msgstr "禁止的根目录"

msgid "One absolute directory per line. These directories and their descendants are denied."
msgstr "每行填写一个绝对目录路径。这些目录及其子目录将被拒绝访问。"

msgid "Security verification"
msgstr "安全验证"

msgid "Enter your password before saving."
msgstr "保存前输入密码"

msgid "Authenticator code"
msgstr "身份验证器验证码"

msgid "Enter the current six-digit code from your authenticator app."
msgstr "输入身份验证器应用当前显示的六位验证码。"


msgid "Reload"
msgstr "重新加载"

msgid "Cannot load path policy"
msgstr "无法加载路径访问策略"

msgid "The active path policy is set by command-line options and cannot be changed here."
msgstr "当前路径策略由命令行参数控制，无法在此修改。"

msgid "Add at least one allowed root directory."
msgstr "请至少添加一个允许访问的根目录。"

msgid "Add at least one blocked root directory."
msgstr "请至少添加一个禁止访问的根目录。"

msgid "Verifying and saving path policy…"
msgstr "正在验证并保存路径策略…"

msgid "Cannot save path policy"
msgstr "无法保存路径访问策略"


msgid "Invalid path list"
msgstr "路径列表无效"

msgid "Paths must be absolute"
msgstr "路径必须为绝对路径"

msgid "Allowlist requires at least one root directory"
msgstr "白名单模式至少需要一个根目录"

msgid "Blacklist requires at least one root directory"
msgstr "黑名单模式至少需要一个根目录"

msgid "Invalid path policy"
msgstr "路径策略无效"

msgid "Path policy is controlled by command-line options"
msgstr "路径策略由命令行参数控制"

msgid "Cannot update active path policy"
msgstr "无法更新当前生效的路径策略"


msgid "Release package version does not match the release tag"
msgstr "发布包版本与发布标签不一致"

msgid "No release package is available for this device target"
msgstr "没有适用于此设备目标的发布包"

msgid "Built-in wallpaper"
msgstr "内置壁纸"

msgid "The built-in wallpaper ships with Harbor Core; provider images are loaded directly by your browser and are not saved on this device."
msgstr "内置壁纸随 Harbor Core 一同提供；其他来源的图片由浏览器直接加载，不会保存到此设备。"

msgid "Midnight Blue"
msgstr "午夜蓝"

msgid "Northern Lights"
msgstr "北极光"

msgid "Neon Horizon"
msgstr "霓虹天际"

msgid "Azure Ribbons"
msgstr "蔚蓝流带"

msgid "Deep Blue Coast"
msgstr "深蓝海岸"

msgid "Last Light"
msgstr "暮色余晖"


msgid "Custom wallpaper"
msgstr "自定义壁纸"

msgid "Too many wallpapers"
msgstr "壁纸数量已达上限"

msgid "Wallpaper file is too large"
msgstr "壁纸文件过大"

msgid "Unsupported image format"
msgstr "不支持的图片格式"

msgid "Uploaded images are stored in the wallpaper folder of the data directory."
msgstr "上传的图片会保存在数据目录的 wallpaper 文件夹中。"

msgid "Save → Folder"
msgstr "保存 → 文件夹"
